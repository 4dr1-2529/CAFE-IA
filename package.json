{
  "name": "cafe-sostenible",
  "private": true,
  "version": "2.0.0",
  "description": "Sistema de Trazabilidad Inteligente para Café Sostenible",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "backend": "npm start --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "npm run backend",
    "test": "npm test --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:seed:pmv2": "npm run db:seed:pmv2 --prefix backend",
    "build": "npm run build --prefix frontend",
    "test:e2e": "cross-env CYPRESS_BASE_URL=http://localhost:5174 cypress run --project testing",
    "test:e2e:open": "cross-env CYPRESS_BASE_URL=http://localhost:5174 cypress open --project testing",
    "test:e2e:report": "cross-env CYPRESS_BASE_URL=http://localhost:5174 cypress run --project testing --reporter spec",
    "metricas": "node testing/metricas/scripts/generar_metricas.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "cypress": "^13.17.0"
  }
}
