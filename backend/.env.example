# Café Sostenible AI - Variables de entorno
NODE_ENV=development
PORT=3029

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafe_sostenible
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=cambiar_este_secreto_en_produccion_min_32_caracteres
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (coma separada)
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# true = exige JWT en todas las rutas API (recomendado staging/producción)
REQUIRE_AUTH=false
