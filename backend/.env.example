# Café Sostenible AI — solo variables MYSQL* (sin DB_HOST / localhost)
NODE_ENV=development
PORT=3029

# MySQL local (XAMPP) — use los mismos nombres que Railway
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=cafe_sostenible
MYSQL_SSL=false

DB_POOL_MIN=2
DB_POOL_MAX=10

JWT_SECRET=cambiar_este_secreto_en_produccion_min_32_caracteres
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

REQUIRE_AUTH=false
ALLOW_PUBLIC_REGISTER=false
